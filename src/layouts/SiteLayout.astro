---
const { title = "CarMediaHub", description = "Self-hosted edge services for browsers and vehicle displays." } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <title>{title} · CarMediaHub</title>
    <script is:inline>const saved = localStorage.getItem('cmh-theme'); if (saved === 'dark' || (!saved && matchMedia('(prefers-color-scheme: dark)').matches)) document.documentElement.dataset.theme = 'dark';</script>
  </head>
  <body>
    <header class="site-header">
      <a class="brand" href="/">CarMediaHub <span>docs</span></a>
      <nav aria-label="Primary navigation">
        <a href="/docs/en/project-goals/">Users</a>
        <a href="/docs/en/architecture/">Architecture</a>
        <a href="/docs/en/plugin-contract/">Developers</a>
        <a href="https://github.com/CarMediaHub">GitHub</a>
      </nav>
      <div class="header-tools"><label class="search"><span class="sr-only">Search</span><input id="search" placeholder="Search docs" /></label><button id="theme" type="button" aria-label="Toggle theme">Theme</button></div>
    </header>
    <div class="shell"><aside class="sidebar"><strong>Documentation</strong><a href="/docs/en/project-origin/">Project origin</a><a href="/docs/en/project-goals/">Project goals</a><a href="/docs/en/quickstart/">User quickstart</a><a href="/docs/en/using-media/">Using media</a><a href="/docs/en/architecture/">Architecture</a><a href="/docs/en/operator-requirements/">Operator requirements</a><a href="/docs/en/plugin-contract/">Plugin contract</a><a href="/docs/en/developer-quickstart/">Developer quickstart</a><a href="/docs/en/security/">Security</a><hr /><a href="/docs/zh/quickstart/">简体中文</a><a href="/docs/ko/quickstart/">한국어</a></aside><main><slot /></main></div>
    <footer><span>CarMediaHub · self-hosted, user-controlled infrastructure</span><span><a href="https://github.com/CarMediaHub/CarMediaHub.github.io">Source</a> · <a href="https://github.com/CarMediaHub/carmediahub-governance">Governance</a></span></footer>
    <script is:inline>
      document.querySelector('#theme')?.addEventListener('click', () => { const dark = document.documentElement.dataset.theme !== 'dark'; document.documentElement.dataset.theme = dark ? 'dark' : 'light'; localStorage.setItem('cmh-theme', dark ? 'dark' : 'light'); });
      const input = document.querySelector('#search'); input?.addEventListener('input', () => { const q = input.value.toLowerCase().trim(); document.querySelectorAll('[data-search]').forEach((el) => { el.hidden = q.length > 0 && !el.textContent.toLowerCase().includes(q); }); });
    </script>
  </body>
</html>
<style>
  :global(:root){font-family:Inter,ui-sans-serif,system-ui,-apple-system,"Segoe UI",sans-serif;color:#17201b;background:#f7f9f7;line-height:1.55} :global(:root[data-theme=dark]){color:#edf5ef;background:#121714} :global(*){box-sizing:border-box} :global(body){margin:0} :global(a){color:#087f5b;text-decoration:none} :global(a:hover){text-decoration:underline}.site-header{min-height:64px;border-bottom:1px solid #d7ddd8;background:color-mix(in srgb,currentColor 3%,transparent);display:flex;align-items:center;gap:28px;padding:0 max(20px,calc((100vw - 1240px)/2));position:sticky;top:0;z-index:2;backdrop-filter:blur(12px)}.brand{font-weight:750;font-size:18px;color:inherit;white-space:nowrap}.brand span{font-size:11px;color:#087f5b;border:1px solid currentColor;padding:2px 5px;margin-left:4px}.site-header nav{display:flex;gap:18px;font-size:14px;flex:1}.site-header nav a{color:inherit}.header-tools{display:flex;gap:8px}.search input{width:180px;border:1px solid #b9c6bc;padding:8px 10px;border-radius:6px;background:transparent;color:inherit}.header-tools button{border:1px solid #b9c6bc;background:transparent;color:inherit;border-radius:6px;padding:7px 10px}.shell{display:grid;grid-template-columns:240px minmax(0,860px);gap:48px;max-width:1240px;margin:0 auto;padding:44px 20px 80px}.sidebar{display:flex;flex-direction:column;gap:10px;font-size:14px;position:sticky;top:100px;align-self:start}.sidebar strong{font-size:13px;text-transform:uppercase;letter-spacing:.08em;margin-bottom:8px}.sidebar a{color:inherit}.sidebar hr{width:100%;border:0;border-top:1px solid #d7ddd8;margin:16px 0}.hero{padding:56px 0 38px;border-bottom:1px solid #d7ddd8}.hero h1{font-size:clamp(34px,5vw,58px);line-height:1.05;margin:0 0 18px;max-width:720px}.hero p{font-size:19px;max-width:690px;color:#55605a}.actions{display:flex;gap:10px;flex-wrap:wrap;margin-top:26px}.button{background:#087f5b;color:white;padding:10px 15px;border-radius:6px;font-weight:650}.button.secondary{background:transparent;color:inherit;border:1px solid #b9c6bc}.cards{display:grid;grid-template-columns:repeat(3,1fr);gap:12px;margin-top:30px}.card{border:1px solid #d7ddd8;padding:18px;background:rgba(255,255,255,.45);border-radius:8px}.card h3{margin:0 0 7px;font-size:16px}.doc h1{font-size:38px;line-height:1.15}.doc h2{margin-top:38px;border-bottom:1px solid #d7ddd8;padding-bottom:8px}.doc pre{overflow:auto;background:#17201b;color:#edf5ef;padding:16px;border-radius:6px}.doc code{font-family:ui-monospace,monospace}.doc table{border-collapse:collapse;width:100%;display:block;overflow:auto}.doc th,.doc td{border:1px solid #d7ddd8;padding:8px;text-align:left}.doc blockquote{border-left:3px solid #087f5b;padding-left:16px;color:#55605a}.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0)}footer{border-top:1px solid #d7ddd8;display:flex;justify-content:space-between;gap:18px;max-width:1240px;margin:auto;padding:22px 20px;font-size:13px;color:#55605a}@media(max-width:820px){.site-header{flex-wrap:wrap;padding:12px 16px;gap:12px}.site-header nav{order:3;width:100%;overflow:auto}.header-tools{margin-left:auto}.search input{width:130px}.shell{display:block;padding:24px 16px}.sidebar{position:static;display:grid;grid-template-columns:repeat(2,1fr);margin-bottom:30px}.sidebar strong,.sidebar hr{grid-column:1/-1}.cards{grid-template-columns:1fr}.hero{padding-top:20px}footer{display:block;padding:18px 16px}footer span{display:block;margin-bottom:8px}}
</style>
