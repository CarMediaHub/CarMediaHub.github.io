---
import SiteLayout from "../layouts/SiteLayout.astro";
import { getDocs, displayPath } from "../lib/docs";
const docs = getDocs().filter((page) => page.locale === "en");
---
<SiteLayout title="Open platform for vehicle-friendly services" description="CarMediaHub is an open, self-hosted edge service platform for browsers and vehicle displays.">
  <section class="hero"><p class="eyebrow">OPEN · SELF-HOSTED · EXTENSIBLE</p><h1>One web surface for your media and local services.</h1><p>CarMediaHub connects operator-controlled storage, media processing and service adapters to browsers and vehicle displays through one protected, extensible platform.</p><div class="actions"><a class="button" href="/docs/en/project-origin/">Understand the project</a><a class="button secondary" href="/docs/en/project-goals/">Explore the goals</a></div></section>
  <section><h2>Choose a path</h2><div class="cards"><article class="card"><h3>Users</h3><p>Learn the problem, deployment boundary and supported outcomes.</p><a href="/docs/en/project-goals/">Start with goals →</a></article><article class="card"><h3>Operators</h3><p>Plan identity, services, routes, storage and recovery.</p><a href="/docs/en/architecture/">Read architecture →</a></article><article class="card"><h3>Developers</h3><p>Build plugins against versioned context, capabilities and lifecycle contracts.</p><a href="/docs/en/plugin-contract/">Open plugin contract →</a></article></div></section>
  <section><h2>Documentation</h2><div class="doc-list">{docs.map((page) => <a data-search href={displayPath(page)}><strong>{page.title}</strong><span>{page.description}</span></a>)}</div></section>
</SiteLayout>
<style>.eyebrow{font-size:12px;letter-spacing:.12em;color:#087f5b;font-weight:700}.hero+section{margin-top:38px}.doc-list{display:grid;gap:8px}.doc-list a{display:grid;gap:3px;border-bottom:1px solid #d7ddd8;padding:12px 0;color:inherit}.doc-list span{font-size:14px;color:#55605a}</style>
